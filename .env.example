CLOUDSDK_CORE_PROJECT=startup-ai-deltasignal
GOOGLE_CLOUD_PROJECT=startup-ai-deltasignal
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
DELTASIGNAL_USE_GEMINI=false
GEMINI_MODEL=gemini-2.5-flash
DELTASIGNAL_AGENT_URL=http://localhost:8080

# Optional app-level key for protecting /v1/brief on public Cloud Run demos.
# Leave blank for local development. Set in Secret Manager for judge demos.
DELTASIGNAL_DEMO_API_KEY=

# Optional live DeltaSignal ATLAS-7 MCP mode.
# Leave disabled for deterministic demos and public repo safety.
DELTASIGNAL_USE_LIVE_MCP=false
DELTASIGNAL_ATLAS_BASE_URL=https://api.aitrailblazer.net
DELTASIGNAL_MCP_ENDPOINT_PATH=/mcp
DELTASIGNAL_MCP_STRESS_TOOL=deltasignal_pressure_board
DELTASIGNAL_MCP_COMPANY_TOOL=deltasignal_company_report
DELTASIGNAL_MCP_PEER_TOOL=deltasignal_peer_ranking
DELTASIGNAL_MCP_TRIPCODE_TOOL=deltasignal_resolve_tripcode_research_packet
MCP_API_KEY=

# Optional local test-spend tracker.
# This is an immediate per-request estimate for demos. Exact Google Cloud
# spend/credits still require Cloud Billing export or the Billing console.
DELTASIGNAL_COST_TRACKING=false
DELTASIGNAL_GOOGLE_CREDIT_BUDGET_USD=500
DELTASIGNAL_ESTIMATED_BRIEF_COST_USD=0.00
DELTASIGNAL_ESTIMATED_TRIPCODE_COST_USD=0.00
DELTASIGNAL_ESTIMATED_SESSION_MEMORY_COST_USD=0.00
DELTASIGNAL_COST_SOURCE=local-estimate

# Optional official Google Cloud Billing status overlay.
# Only set DELTASIGNAL_OFFICIAL_BILLING_AVAILABLE=true when these values come
# from Cloud Billing export, the Billing console, or another official source.
# If unset, /v1/usage still reports local estimates and marks official billing
# as unavailable instead of inventing current spend.
DELTASIGNAL_OFFICIAL_BILLING_AVAILABLE=false
DELTASIGNAL_OFFICIAL_BILLING_SOURCE=unavailable
DELTASIGNAL_BILLING_PROJECT_ID=startup-ai-deltasignal
DELTASIGNAL_BILLING_ACCOUNT_NAME=
DELTASIGNAL_BILLING_ENABLED=false
DELTASIGNAL_OFFICIAL_BILLING_SPENT_USD=0.00
DELTASIGNAL_OFFICIAL_BILLING_CREDIT_BUDGET_USD=500
DELTASIGNAL_OFFICIAL_BILLING_REMAINING_USD=0.00
DELTASIGNAL_OFFICIAL_BILLING_UPDATED_AT=

# Optional Track 2 runtime guardrails.
# Cloud Run deployment enables rate limiting by default. Local development can
# leave it disabled unless you are testing abuse-protection behavior.
DELTASIGNAL_RATE_LIMIT_ENABLED=false
DELTASIGNAL_RATE_LIMIT_PER_WINDOW=30
DELTASIGNAL_RATE_LIMIT_WINDOW_SECONDS=60

# Optional TripCode session memory settings.
# DELTASIGNAL_MEMORY_FILE is useful for local or single-instance validation.
# Do not treat Cloud Run's ephemeral filesystem as durable production storage.
DELTASIGNAL_MEMORY_MAX_ENTRIES=20
DELTASIGNAL_MEMORY_FILE=

# Optional Track 3 A2A / Gemini Enterprise / Marketplace readiness.
# DELTASIGNAL_PUBLIC_BASE_URL should match the externally reachable service
# URL so the agent card advertises a callable /a2a endpoint.
DELTASIGNAL_PUBLIC_BASE_URL=https://deltasignal-ai-agent-mhaufviwaq-uc.a.run.app
DELTASIGNAL_A2A_PROTOCOL_VERSION=0.3.0
DELTASIGNAL_AGENT_VERSION=1.0.0
